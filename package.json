{
	"name": "n8n-nodes-decalegal",
	"version": "0.1.0",
	"description": "n8n community node for DecaLegal: create transports, issue the Spanish DeCA (electronic road transport control document) and react to its webhooks",
	"keywords": [
		"n8n-community-node-package",
		"decalegal",
		"deca",
		"documento de control",
		"transport",
		"logistics",
		"spain"
	],
	"license": "MIT",
	"homepage": "https://deca.legal/integraciones",
	"author": {
		"name": "mimotic",
		"email": "mcacho@mimotic.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mimotic/n8n-nodes-decalegal.git"
	},
	"engines": {
		"node": ">=20.15"
	},
	"main": "index.js",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "n8n-node build",
		"build:tsc": "tsc && node scripts/copy-icons.mjs",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/DecaLegalApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/DecaLegal/DecaLegal.node.js",
			"dist/nodes/DecaLegal/DecaLegalTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.51.5",
		"@types/node": "^22.15.0",
		"n8n-workflow": "*",
		"typescript": "^5.8.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
